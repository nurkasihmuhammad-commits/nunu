<!DOCTYPE html><html lang="id"><head><base target="_top"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>
:root{font-family:Inter,system-ui,Arial,sans-serif;color:#1d2c3b;background:#f1f5f9}*{box-sizing:border-box}body{margin:0}header{background:linear-gradient(100deg,#0f766e,#0b4c75);color:white;padding:18px 5%;display:flex;align-items:center;justify-content:space-between;gap:20px}header strong{font-size:22px}header small{display:block;opacity:.85}main{max-width:1150px;margin:24px auto;padding:0 16px}.panel{background:white;border-radius:16px;box-shadow:0 7px 24px #19385a12;padding:24px;margin-bottom:18px}.login{max-width:450px;margin:8vh auto}.title{font-size:24px;font-weight:750;margin:0 0 5px}.muted{color:#64748b;font-size:13px}label{font-size:13px;font-weight:650;display:block;margin:12px 0 6px}input,select,textarea{border:1px solid #cbd5e1;border-radius:9px;padding:11px 12px;width:100%;font:inherit;background:#fff}textarea{min-height:80px}button{border:0;border-radius:9px;background:#0f766e;color:#fff;font-weight:700;padding:10px 16px;cursor:pointer}button.secondary{background:#e2e8f0;color:#1e293b}button.danger{background:#fee2e2;color:#991b1b}button:disabled{opacity:.5;cursor:not-allowed}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 20px}.tabs button{background:#e2e8f0;color:#0f172a}.tabs button.active{background:#0f766e;color:white}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.flex{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.row{display:flex;justify-content:space-between;align-items:center;gap:15px}.hide{display:none!important}.notice{border-radius:10px;background:#e0f2fe;color:#075985;padding:12px;margin:14px 0}.alert{border-radius:10px;background:#fee2e2;color:#991b1b;padding:12px;margin:14px 0}.tablewrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:11px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:top}th{background:#e8f5f2;color:#0f524b}td .flex{flex-wrap:nowrap}.thumb{max-width:160px;max-height:115px;object-fit:contain;display:block;border-radius:8px;margin-top:6px}.question{padding:15px;border:1px solid #e2e8f0;border-radius:12px;margin:15px 0}.option{display:flex;align-items:flex-start;gap:12px;border:1px solid #e2e8f0;border-radius:10px;padding:12px;margin:9px 0;cursor:pointer}.option:has(input:checked){border-color:#0f766e;background:#f0fdfa}.option input{width:auto;margin-top:4px}.chip{background:#ccfbf1;color:#115e59;padding:6px 11px;border-radius:99px;font-weight:700}.timer{background:#0f766e;color:white;padding:8px 13px;border-radius:9px;font-variant-numeric:tabular-nums}.timer.low{background:#b91c1c}.navnums{display:flex;flex-wrap:wrap;gap:7px}.navnums button{padding:9px;min-width:42px;background:#e2e8f0;color:#334155}.navnums button.done{background:#99f6e4;color:#134e4a}.navnums button.current{outline:2px solid #0f766e}.score{font-size:48px;font-weight:800;color:#0f766e}.metric{background:#f8fafc;border-radius:12px;padding:15px}.metric strong{display:block;font-size:26px;color:#0f766e}.imgfield{border:1px dashed #94a3b8;padding:10px;border-radius:9px;background:#f8fafc}.imgfield input{font-size:12px}#loading{position:fixed;inset:0;background:#0f172a50;display:none;place-items:center;z-index:99}#loading>div{background:white;padding:22px 35px;border-radius:12px;font-weight:bold}#toast{position:fixed;bottom:18px;right:18px;background:#0f172a;color:white;padding:13px 19px;border-radius:9px;display:none;z-index:100;max-width:350px}@media(max-width:750px){.two,.three{grid-template-columns:1fr}.panel{padding:16px}header{padding:14px 18px}header strong{font-size:18px}}

.exam-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:20px;align-items:start}.exam-side{border:1px solid #dbe3ec;border-radius:12px;padding:15px;position:sticky;top:12px}.exam-side h3{margin:0 0 12px}.navnums button{min-width:0;width:100%;height:38px;background:#fff;border:1px solid #aab7c6;color:#334155}.navnums{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.navnums button.done{background:#27384a;color:white;border-color:#27384a}.navnums button.doubt{background:#facc15;color:#422006;border-color:#ca8a04}.navnums button.current{outline:2px solid #0f766e;outline-offset:2px}.legend{display:flex;align-items:center;gap:8px;font-size:12px;margin:8px 0}.swatch{width:17px;height:17px;border-radius:4px;border:1px solid #aab7c6;background:white}.swatch.done{background:#27384a}.swatch.doubt{background:#facc15;border-color:#ca8a04}.doubt-toggle{background:#fef3c7;color:#713f12;border:1px solid #eab308}.doubt-toggle[aria-pressed=true]{background:#facc15;color:#422006}.exam-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.exam-actions button{flex:1}.exam-grid .thumb{max-width:100%;max-height:420px}.exam-grid .option .thumb{max-height:230px}.progress-track{height:7px;background:#e2e8f0;border-radius:10px;overflow:hidden;margin:10px 0}.progress-track span{display:block;height:100%;background:#0f766e}.exam-grid .question{margin-top:0}.exam-grid .option{font-size:15px}.exam-side .muted{line-height:1.6}.exam-side .submit-button{width:100%;margin-top:14px}@media(max-width:750px){.exam-grid{grid-template-columns:1fr}.exam-side{position:static}.navnums{grid-template-columns:repeat(5,minmax(0,1fr))}.exam-actions button{padding:10px 8px;font-size:12px}}
</style></head><body><header><div><strong>🎓 SIGAPPA CBT</strong><small>Asesmen Sumatif Akhir Semester Gasal</small></div><button class="secondary hide" id="logout" onclick="logout()">Keluar</button></header><main id="app"></main><div id="loading"><div>Memproses data…</div></div><div id="toast"></div><script>
let token='',role='',admin={},exam=null,answers={},index=0,ticker=null,seconds=0,identity={};const app=document.getElementById('app');
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function toast(s,bad=false){const el=document.getElementById('toast');el.textContent=s;el.style.background=bad?'#991b1b':'#0f766e';el.style.display='block';setTimeout(()=>el.style.display='none',4200)}
function wait(on){document.getElementById('loading').style.display=on?'grid':'none'}
function api(action,payload={}){wait(true);return new Promise((resolve,reject)=>{google.script.run.withSuccessHandler(x=>{wait(false);resolve(x)}).withFailureHandler(e=>{wait(false);toast(e.message||String(e),true);reject(e)}).run(action,payload,token)})}
function element(id){return document.getElementById(id)}
function value(id){return element(id)?.value||''}
function loginScreen(which='siswa'){role='';token='';element('logout').classList.add('hide');app.innerHTML=`<div class="panel login"><h1 class="title">Masuk ke SIGAPPA CBT</h1><p class="muted">Pilih akun siswa atau administrator.</p><div class="tabs"><button class="${which==='siswa'?'active':''}" onclick="loginScreen('siswa')">Peserta Ujian</button><button class="${which==='admin'?'active':''}" onclick="loginScreen('admin')">Administrator</button></div>${which==='admin'?`<label>Password Admin</label><input type="password" id="password" placeholder="Password admin">`:`<label>Pilih Sekolah</label><select id="sekolah"><option value="">Memuat sekolah…</option></select><label>Username / NISN</label><input id="username" autocomplete="username" placeholder="Contoh: siswa001"><label>Password</label><input type="password" id="password" autocomplete="current-password" placeholder="Password peserta">`}<button style="width:100%;margin-top:18px" onclick="login('${which}')">Masuk</button><div class="notice">Pilih sekolah sesuai data peserta. Selama ujian, batas pelanggaran keluar halaman adalah 5 kali.</div></div>`;if(which==='siswa')loadSchools();}
async function loadSchools(){try{const r=await api('publicInfo');const el=element('sekolah');if(el)el.innerHTML='<option value="">-- Pilih sekolah --</option>'+r.schools.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');}catch(e){}}
async function login(which){try{const r=await api(which==='admin'?'loginAdmin':'loginSiswa',{username:value('username'),password:value('password'),sekolah:value('sekolah')});token=r.token;role=r.role;identity=r;element('logout').classList.remove('hide');if(role==='admin')await refreshAdmin();else await studentHome()}catch(e){}}
async function logout(){if(exam){toast('Selesaikan ujian terlebih dahulu',true);return;}if(token)try{await api('logout')}catch(e){}clearInterval(ticker);loginScreen()}
async function refreshAdmin(tab='questions'){try{admin=await api('adminData');adminView(tab)}catch(e){}}
function adminView(tab='questions'){const tabs={questions:'Bank Soal',students:'Peserta',results:'Hasil Ujian',settings:'Pengaturan'};app.innerHTML=`<section class="panel"><div class="row"><div><h1 class="title">Dashboard Administrator</h1><p class="muted">Kelola soal, gambar, peserta dan nilai langsung di Google Sheets.</p></div><span class="chip">Admin</span></div><div class="three"><div class="metric">Soal<strong>${admin.questions.length}</strong></div><div class="metric">Peserta<strong>${admin.students.length}</strong></div><div class="metric">Hasil masuk<strong>${admin.results.length}</strong></div></div><div class="tabs">${Object.entries(tabs).map(([key,t])=>`<button class="${tab===key?'active':''}" onclick="adminView('${key}')">${t}</button>`).join('')}</div><div id="adminContent"></div></section>`;
 if(tab==='questions')questionsView();if(tab==='students')studentsView();if(tab==='results')resultsView();if(tab==='settings')settingsView();}
function img(url){return url?`<img class="thumb" src="${esc(url)}" alt="Gambar soal atau jawaban" onerror="this.style.display='none'">`:''}
function imgInput(id,label,current=''){return `<div class="imgfield"><label>${label}</label><input id="${id}" value="${esc(current)}" placeholder="URL gambar atau unggah file"><input type="file" accept="image/png,image/jpeg,image/webp,image/gif" onchange="upload('${id}',this)">${img(current)}<small class="muted">PNG, JPG, WebP atau GIF; maksimal 2 MB. Gambar tersimpan di Drive.</small></div>`}
function questionsView(){element('adminContent').innerHTML=`<div class="row"><h2>Bank Soal</h2><button onclick="questionForm()">+ Tambah Soal</button></div><div class="tablewrap"><table><thead><tr><th>ID</th><th>Mapel</th><th>Pertanyaan</th><th>Gambar</th><th>Kunci</th><th>Aksi</th></tr></thead><tbody>${admin.questions.map(q=>`<tr><td>${esc(q.ID)}</td><td>${esc(q.Mapel)}</td><td>${esc(q.Pertanyaan).slice(0,130)}</td><td>${img(q.GambarSoal)}</td><td>${esc(q.Kunci)}</td><td><div class="flex"><button class="secondary" onclick="questionForm('${esc(q.ID)}')">Edit</button><button class="danger" onclick="delQuestion('${esc(q.ID)}')">Hapus</button></div></td></tr>`).join('')}</tbody></table></div><div id="editor"></div>`}
function questionForm(id=''){const q=admin.questions.find(x=>String(x.ID)===id)||{},fields=['A','B','C','D'];element('editor').innerHTML=`<hr style="border:0;border-top:1px solid #e2e8f0;margin:25px 0"><h2>${id?'Edit':'Tambah'} Soal</h2><div class="two"><div><label>ID (otomatis jika kosong)</label><input id="q_ID" value="${esc(q.ID)}" ${id?'readonly':''}></div><div><label>Mata Pelajaran</label><input id="q_Mapel" value="${esc(q.Mapel||'Matematika')}"></div></div><label>Pertanyaan</label><textarea id="q_Pertanyaan">${esc(q.Pertanyaan)}</textarea>${imgInput('q_GambarSoal','Gambar Pertanyaan (opsional)',q.GambarSoal)}<div class="two">${fields.map(k=>`<div><label>Jawaban ${k}</label><textarea id="q_Opsi${k}">${esc(q['Opsi'+k])}</textarea>${imgInput('q_Gambar'+k,'Gambar Jawaban '+k+' (opsional)',q['Gambar'+k])}</div>`).join('')}</div><div class="three"><div><label>Kunci Benar</label><select id="q_Kunci">${fields.map(k=>`<option ${q.Kunci===k?'selected':''}>${k}</option>`).join('')}</select></div><div><label>Bobot Poin</label><input type="number" id="q_Poin" min="1" value="${esc(q.Poin||10)}"></div><div><label>Status</label><select id="q_Aktif"><option ${q.Aktif!=='TIDAK'?'selected':''}>YA</option><option ${q.Aktif==='TIDAK'?'selected':''}>TIDAK</option></select></div></div><div class="flex" style="margin-top:18px"><button onclick="saveQuestion()">Simpan Soal</button><button class="secondary" onclick="element('editor').innerHTML=''">Batal</button></div>`;element('editor').scrollIntoView({behavior:'smooth',block:'start'});}
async function upload(id,input){const f=input.files?.[0];if(!f)return;if(f.size>2*1024*1024){toast('Gambar maksimal 2 MB',true);input.value='';return}try{const b64=await new Promise((ok,fail)=>{const reader=new FileReader();reader.onload=()=>ok(String(reader.result).split(',')[1]);reader.onerror=fail;reader.readAsDataURL(f)});const r=await api('uploadImage',{mime:f.type,base64:b64});element(id).value=r.url;const preview=input.parentElement.querySelector('img');if(preview)preview.src=r.url;else input.insertAdjacentHTML('afterend',img(r.url));toast('Gambar berhasil diunggah')}catch(e){} }
async function saveQuestion(){const names=['ID','Mapel','Pertanyaan','GambarSoal','OpsiA','GambarA','OpsiB','GambarB','OpsiC','GambarC','OpsiD','GambarD','Kunci','Poin','Aktif'],q={};names.forEach(k=>q[k]=value('q_'+k));if(!q.Pertanyaan||!q.Mapel||!['A','B','C','D'].every(k=>q['Opsi'+k]||q['Gambar'+k]))return toast('Lengkapi pertanyaan, mapel dan keempat pilihan (teks atau gambar)',true);try{await api('saveQuestion',q);toast('Soal disimpan');await refreshAdmin()}catch(e){}}
async function delQuestion(id){if(!confirm('Hapus soal '+id+'?'))return;try{await api('deleteQuestion',{id});await refreshAdmin()}catch(e){}}
function studentsView(){element('adminContent').innerHTML=`<div class="row"><h2>Data Peserta</h2><button onclick="studentForm()">+ Tambah Peserta</button></div><div class="tablewrap"><table><tr><th>Username</th><th>Nama</th><th>Nama Sekolah</th><th>Kelas</th><th>Aktif</th><th>Aksi</th></tr>${admin.students.map(s=>`<tr><td>${esc(s.Username)}</td><td>${esc(s.Nama)}</td><td>${esc(s.NamaSekolah)}</td><td>${esc(s.Kelas)}</td><td>${esc(s.Aktif)}</td><td><button class="secondary" onclick="studentForm('${esc(s.Username)}')">Edit</button> <button class="danger" onclick="delStudent('${esc(s.Username)}')">Hapus</button></td></tr>`).join('')}</table></div><div id="editor"></div>`}
function studentForm(id=''){const s=admin.students.find(x=>String(x.Username)===id)||{};element('editor').innerHTML=`<h2>${id?'Edit':'Tambah'} Peserta</h2><div class="two"><div><label>Username/NISN</label><input id="s_Username" value="${esc(s.Username)}" ${id?'readonly':''}></div><div><label>Nama Lengkap</label><input id="s_Nama" value="${esc(s.Nama)}"></div><div><label>Nama Sekolah</label><input id="s_NamaSekolah" value="${esc(s.NamaSekolah)}" required></div><div><label>Kelas</label><input id="s_Kelas" value="${esc(s.Kelas)}"></div><div><label>Password Peserta</label><input id="s_Password" value="${esc(s.Password)}"></div></div><label>Status</label><select id="s_Aktif"><option ${s.Aktif!=='TIDAK'?'selected':''}>YA</option><option ${s.Aktif==='TIDAK'?'selected':''}>TIDAK</option></select><button style="margin-top:15px" onclick="saveStudent()">Simpan Peserta</button>`;element('editor').scrollIntoView({behavior:'smooth'})}
async function saveStudent(){let x={};['Username','Nama','Kelas','Password','Aktif','NamaSekolah'].forEach(k=>x[k]=value('s_'+k));try{await api('saveStudent',x);toast('Peserta disimpan');await refreshAdmin('students')}catch(e){}}
async function delStudent(username){if(!confirm('Hapus peserta '+username+'?'))return;try{await api('deleteStudent',{username});await refreshAdmin('students')}catch(e){}}
function resultsView(){element('adminContent').innerHTML=`<div class="row"><h2>Rekap Nilai</h2><button onclick="downloadCSV()">Unduh CSV</button></div><div class="tablewrap"><table><tr><th>Tanggal</th><th>Username</th><th>Nama</th><th>Nama Sekolah</th><th>Kelas</th><th>Mapel</th><th>Nilai</th><th>Benar</th></tr>${admin.results.map(x=>`<tr><td>${esc(String(x.WaktuSubmit))}</td><td>${esc(x.Username)}</td><td>${esc(x.Nama)}</td><td>${esc(x.NamaSekolah)}</td><td>${esc(x.Kelas)}</td><td>${esc(x.Mapel)}</td><td><b>${esc(x.Skor)}</b></td><td>${esc(x.Benar)}/${esc(x.JumlahSoal)}</td></tr>`).join('')}</table></div><p class="muted">Nilai juga tersedia otomatis pada sheet HASIL di Google Spreadsheet.</p>`}
function downloadCSV(){const cols=['WaktuSubmit','Username','Nama','NamaSekolah','Kelas','Mapel','Skor','Benar','JumlahSoal'],rows=[cols,...admin.results.map(x=>cols.map(k=>String(x[k]??'')))];const csv='\uFEFF'+rows.map(r=>r.map(v=>'"'+v.replace(/"/g,'""')+'"').join(',')).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='SIGAPPA_Hasil.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function settingsView(){const c=admin.config;element('adminContent').innerHTML=`<h2>Pengaturan Ujian</h2><div class="two"><div><label>Nama Aplikasi</label><input id="c_NamaAplikasi" value="${esc(c.NamaAplikasi)}"></div><div><label>Durasi Ujian per Mapel (menit)</label><input type="number" min="1" max="240" id="c_DurasiMenit" value="${esc(c.DurasiMenit)}"></div></div><label>Ujian Aktif</label><select id="c_UjianAktif"><option ${c.UjianAktif==='YA'?'selected':''}>YA</option><option ${c.UjianAktif==='TIDAK'?'selected':''}>TIDAK</option></select><button style="margin-top:15px" onclick="saveConfig()">Simpan Pengaturan</button><div class="notice">Untuk mengedit soal/peserta secara massal, buka tab SOAL atau PESERTA pada Google Spreadsheet yang terhubung. URL gambar dapat diisi melalui form unggah.</div><h2 style="margin-top:24px">Jadwal Ujian per Mata Pelajaran (WITA)</h2><label>Mata Pelajaran</label><select id="j_mapel" onchange="fillSchedule()">${[...new Set(['Matematika','Bahasa Indonesia','Bahasa Inggris','IPA','IPS','PPKn','PAI/Agama','Seni Budaya','PJOK',...admin.questions.map(q=>q.Mapel),...admin.schedules.map(j=>j.Mapel)])].map(m=>`<option>${esc(m)}</option>`).join('')}</select><div class="two"><div><label>Tanggal Ujian</label><input type="date" id="j_tanggal" onchange="updateDay()"></div><div><label>Hari (otomatis)</label><input id="j_hari" readonly></div></div><div class="two"><div><label>Jam Mulai (WITA)</label><input type="time" id="j_mulai"></div><div><label>Jam Selesai (WITA)</label><input type="time" id="j_selesai"></div></div><p class="muted">Jam mulai dan selesai berlaku pada tanggal yang sama. Pilih Edit untuk mengubah jadwal kapan saja.</p><label>Durasi (menit)</label><input type="number" id="j_durasi" min="1" max="240"><button style="margin-top:15px" onclick="saveSchedule()">Simpan Jadwal Mapel</button><div class="tablewrap"><table><tr><th>Mapel</th><th>Hari</th><th>Tanggal</th><th>Mulai WITA</th><th>Selesai WITA</th><th>Durasi</th><th>Aksi</th></tr>${admin.schedules.map((j,i)=>`<tr><td>${esc(j.Mapel)}</td><td>${esc(dayName(String(j.MulaiWITA||'').slice(0,10)))}</td><td>${esc(String(j.MulaiWITA||'').slice(0,10))}</td><td>${esc(String(j.MulaiWITA||'').slice(11,16))}</td><td>${esc(String(j.SelesaiWITA||'').slice(11,16))}</td><td>${esc(j.DurasiMenit)}</td><td><button onclick="editSchedule(${i})">Edit</button></td></tr>`).join('')}</table></div>`;fillSchedule()}
function dayName(a){const d=new Date(a+'T00:00:00Z');return Number.isFinite(d.getTime())?['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'][d.getUTCDay()]:'';}
function updateDay(resetEnd=false){const a=value('j_tanggal');element('j_hari').value=dayName(a);}
function fillSchedule(){const j=admin.schedules.find(x=>x.Mapel===value('j_mapel'))||{};const a=String(j.MulaiWITA||''),b=String(j.SelesaiWITA||'');element('j_tanggal').value=a.slice(0,10)||j.Tanggal||'';element('j_mulai').value=a.slice(11,16);element('j_selesai').value=b.slice(11,16);element('j_durasi').value=j.DurasiMenit||admin.config.DurasiMenit||45;updateDay();}
function editSchedule(i){element('j_mapel').value=admin.schedules[i].Mapel;fillSchedule();element('j_mapel').scrollIntoView({behavior:'smooth',block:'center'});}
async function saveSchedule(){try{await api('saveSchedule',{mapel:value('j_mapel'),mulai:value('j_tanggal')+'T'+value('j_mulai'),selesai:value('j_tanggal')+'T'+value('j_selesai'),durasi:value('j_durasi')});toast('Jadwal tersimpan');const m=value('j_mapel');await refreshAdmin('settings');element('j_mapel').value=m;fillSchedule()}catch(e){}}
async function saveConfig(){let p={};['NamaAplikasi','DurasiMenit','UjianAktif'].forEach(k=>p[k]=value('c_'+k));try{await api('saveConfig',p);toast('Pengaturan disimpan');await refreshAdmin('settings')}catch(e){}}
async function studentHome(){clearInterval(ticker);try{const r=await api('getExam');app.innerHTML=`<section class="panel"><div class="row"><div><h1 class="title">Selamat datang, ${esc(r.name)}</h1><p class="muted">${esc(r.sekolah)} · Kelas ${esc(r.kelas)} · Durasi ${r.duration} menit per mapel</p></div><span class="chip">Peserta</span></div><h2>Pilih mata pelajaran</h2>${r.subjects.length?`<div class="three">${r.subjects.map(s=>`<div class="metric"><h3>${esc(s)}</h3><p class="muted">${esc(r.schedules.find(j=>j.mapel===s)?.label||'')}</p><button onclick="startExam('${esc(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'")}')">Mulai / Lanjutkan</button></div>`).join('')}</div>`:'<div class="notice">Semua mata pelajaran sudah dikerjakan atau belum ada ujian yang tersedia.</div>'}</section>`}catch(e){}}
async function startExam(mapel){try{exam=await api('startExam',{mapel});answers={...exam.answers,...readDraft(mapel)};index=0;doubts=readDoubts(mapel);pending=0;away=false;seconds=exam.secondsLeft;violations=exam.violations||0;deadline=Date.now()+seconds*1000;element('logout').classList.add('hide');renderExam();if(violations>=5||seconds===0){submitExam(true);return;}clearInterval(ticker);ticker=setInterval(()=>{seconds=Math.max(0,Math.ceil((deadline-Date.now())/1000));timerView();if(seconds===0&&!reporting){clearInterval(ticker);submitExam(true)}},1000)}catch(e){}}
function timerView(){const t=element('timer');if(t){t.textContent=`⏱ ${String(Math.floor(seconds/60)).padStart(2,'0')}:${String(seconds%60).padStart(2,'0')}`;t.classList.toggle('low',seconds<60)}}
function selectAnswer(id,k){if(sending||violations+pending>=5||Date.now()>=deadline)return;answers[id]=k;try{localStorage.setItem(draftKey(exam.mapel),JSON.stringify(answers))}catch(e){}renderExam()}
let doubts={};
function doubtKey(m){return draftKey(m)+':doubt';}
function readDoubts(m){try{return JSON.parse(localStorage.getItem(doubtKey(m))||'{}')||{}}catch(e){return {}}}
function toggleDoubt(){if(!exam||sending||violations+pending>=5||Date.now()>=deadline)return;const id=exam.questions[index].ID;if(doubts[id])delete doubts[id];else doubts[id]=true;try{localStorage.setItem(doubtKey(exam.mapel),JSON.stringify(doubts))}catch(e){}renderExam()}
function examCounts(){const qs=exam.questions;return {total:qs.length,answered:qs.filter(q=>['A','B','C','D'].includes(answers[q.ID])).length,doubt:qs.filter(q=>doubts[q.ID]).length};}
function goQuestion(i){if(!exam||i<0||i>=exam.questions.length)return;index=i;renderExam();window.scrollTo(0,0)}
function renderExam(){const q=exam.questions[index],c=examCounts();app.innerHTML=`<div class="panel"><div class="row"><div><h1 class="title">${esc(exam.mapel)}</h1><p class="muted" id="security">Pelanggaran: ${violations}/5 · Jangan keluar dari halaman ujian.</p><p class="muted">Soal ${index+1} dari ${c.total}</p></div><strong class="timer" id="timer"></strong></div><div class="exam-grid"><div><div class="question"><h2 style="font-size:19px">${index+1}. ${esc(q.Pertanyaan)}</h2>${img(q.GambarSoal)}${['A','B','C','D'].map(k=>`<label class="option"><input type="radio" name="jawab" ${answers[q.ID]===k?'checked':''} onchange="selectAnswer(exam.questions[index].ID,'${k}')"><b>${k}.</b><div>${esc(q['Opsi'+k])}${img(q['Gambar'+k])}</div></label>`).join('')}</div><div class="exam-actions"><button class="secondary" ${index===0?'disabled':''} onclick="goQuestion(index-1)">← Sebelumnya</button><button class="doubt-toggle" aria-pressed="${!!doubts[q.ID]}" onclick="toggleDoubt()">${doubts[q.ID]?'☑':'☐'} Ragu-ragu</button><button ${index===c.total-1?'disabled':''} onclick="goQuestion(index+1)">Berikutnya →</button></div></div><aside class="exam-side"><h3>Daftar Soal</h3><div class="muted">Terjawab: <b>${c.answered}/${c.total}</b> · Kosong: <b>${c.total-c.answered}</b><br>Ragu-ragu: <b>${c.doubt}</b></div><div class="progress-track"><span style="width:${c.total?100*c.answered/c.total:0}%"></span></div><div class="navnums">${exam.questions.map((x,i)=>`<button class="${doubts[x.ID]?'doubt':answers[x.ID]?'done':''} ${i===index?'current':''}" aria-label="Soal ${i+1}, ${doubts[x.ID]?'ragu-ragu, ':''}${answers[x.ID]?'terjawab':'belum dijawab'}" ${i===index?'aria-current="true"':''} onclick="goQuestion(${i})">${i+1}${answers[x.ID]?' · '+esc(answers[x.ID]):''}</button>`).join('')}</div><div style="margin-top:14px"><div class="legend"><span class="swatch"></span>Belum dijawab</div><div class="legend"><span class="swatch done"></span>Sudah dijawab</div><div class="legend"><span class="swatch doubt"></span>Ragu-ragu</div><div class="legend"><span class="swatch" style="outline:2px solid #0f766e"></span>Soal aktif</div></div><button class="submit-button" onclick="submitExam(false)">Kumpulkan Ujian</button></aside></div></div>`;timerView()}
async function submitExam(automatic){if(!exam||sending||reporting)return;const c=examCounts();if(!automatic&&!confirm(`Kumpulkan ujian?\nSudah dijawab: ${c.answered}/${c.total}\nBelum dijawab: ${c.total-c.answered}\nRagu-ragu: ${c.doubt}\n${c.doubt||c.answered<c.total?"Masih ada soal yang perlu diperiksa. ":""}Klik OK untuk mengakhiri ujian.`))return;if(!exam||sending||reporting)return;sending=true;clearInterval(ticker);try{const r=await api('submitExam',{mapel:exam.mapel,answers});finishExam(r); }catch(e){sending=false;app.innerHTML=`<div class="panel"><h2>Pengiriman belum berhasil</h2><p>Jawaban masih tersedia. Coba kirim lagi.</p><button onclick="submitExam(true)">Coba Kirim Lagi</button></div>`}}
function finishExam(r){clearInterval(ticker);try{localStorage.removeItem(draftKey(exam.mapel));localStorage.removeItem(doubtKey(exam.mapel))}catch(e){}element('logout').classList.remove('hide');app.innerHTML=`<div class="panel" style="max-width:620px;margin:8vh auto;text-align:center"><h1>Ujian Selesai</h1><p class="muted">Hasil berhasil disimpan ke Google Spreadsheet.</p><div class="score">${r.score}</div><p>Jawaban benar: <b>${r.correct}</b> dari <b>${r.total}</b> soal</p><button onclick="studentHome()">Kembali ke Daftar Mapel</button></div>`;exam=null;sending=false;}
let violations=0,deadline=0,sending=false,away=false,reporting=false,pending=0;
function draftKey(m){return 'sigappa:'+identity.sekolah+':'+identity.username+':'+m;}
function readDraft(m){try{return JSON.parse(localStorage.getItem(draftKey(m))||'{}')}catch(e){return {}}}
function detectAway(){if(!exam||sending||away||violations+pending>=5)return;away=true;pending++;if(violations+pending>=5)toast('Batas 5 pelanggaran tercapai. Ujian dikumpulkan otomatis.',true);flushViolations();}
async function flushViolations(){if(reporting||!exam||!pending||sending)return;reporting=true;try{while(pending&&exam&&!sending){const r=await api('violation',{mapel:exam.mapel,answers});pending--;violations=r.count;if(r.finished){finishExam(r.finished);break;}const el=element('security');if(el)el.textContent='Pelanggaran: '+violations+'/5 · Jangan keluar dari halaman ujian.';toast('Peringatan '+violations+'/5: jangan meninggalkan halaman ujian.',true);}}catch(e){toast('Gagal mencatat pelanggaran. Kembali ke halaman untuk mencoba lagi.',true);}finally{reporting=false;}}
document.addEventListener('visibilitychange',()=>{if(document.hidden)detectAway();else{away=false;flushViolations();}});
window.addEventListener('blur',detectAway);window.addEventListener('focus',()=>{if(!document.hidden){away=false;flushViolations();}});
window.addEventListener('beforeunload',e=>{if(exam&&!sending){e.preventDefault();e.returnValue='';}});
loginScreen();
</script></body></html>
